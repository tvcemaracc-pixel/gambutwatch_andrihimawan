.dashboard-ref .doc-row{display:grid;grid-template-columns:repeat(2,1fr);gap:8px}.dashboard-ref .doc-mini{height:95px;border-radius:9px;overflow:hidden;position:relative;background:linear-gradient(135deg,#91ad7e,#355c44);color:#fff;display:flex;align-items:flex-end;padding:8px;font-size:8px;font-weight:800;box-shadow:inset 0 -55px 55px rgba(0,0,0,.35)}
.dashboard-ref .doc-mini:nth-child(2){background:linear-gradient(135deg,#b8d4ef,#507f59)}.dashboard-ref .doc-mini:nth-child(3){background:linear-gradient(135deg,#88a96f,#294e35)}.dashboard-ref .doc-mini:nth-child(4){background:linear-gradient(135deg,#a9d0e5,#486d4c)}
.dashboard-ref .doc-mini small{display:block;font-size:7px;opacity:.9;font-weight:500;margin-top:2px}
.dashboard-ref .bottom-row{display:grid;grid-template-columns:1.55fr .78fr;gap:10px;margin-top:10px}.dashboard-ref .bottom-row .card{margin-bottom:0;padding:13px;border-radius:12px}
.dashboard-ref .status-summary{display:flex;align-items:center;justify-content:space-between;gap:12px}.dashboard-ref .summary-left{display:flex;align-items:center;gap:9px}.dashboard-ref .summary-badge{padding:8px 17px;border-radius:999px;background:#dff4e5;color:#267348;font-weight:900;font-size:10px}.dashboard-ref .summary-items{display:flex;gap:8px;flex:1}.dashboard-ref .summary-item{flex:1;border-left:1px solid #e0e8e3;padding-left:12px}.dashboard-ref .summary-item b{font-size:10px;display:block}.dashboard-ref .summary-item span{font-size:8px;color:#77847d}
.dashboard-ref .quick-actions{display:grid;grid-template-columns:repeat(4,1fr);gap:7px}.dashboard-ref .quick-action{border:1px solid #d9e7df;border-radius:9px;background:#fff;padding:9px 4px;text-align:center;font-size:8px;font-weight:800;color:#184b39}.dashboard-ref .quick-action div{font-size:18px;margin-bottom:3px}
.dashboard-ref .ref-credit{font-size:9px;color:#718178;margin-top:3px}
@media(max-width:1200px){.dashboard-ref .kpi-ref{grid-template-columns:repeat(3,1fr)}.dashboard-ref .panel-row,.dashboard-ref .lower-row,.dashboard-ref .bottom-row{grid-template-columns:1fr}.dashboard-ref .info-strip{display:none}}
@media(max-width:700px){.dashboard-ref .kpi-ref{grid-template-columns:repeat(2,1fr)}.dashboard-ref .welcome-strip{position:relative;z-index:1;grid-template-columns:1fr}.dashboard-ref .doc-row{grid-template-columns:1fr 1fr}}

.reset-card{border:1px solid #f0d6d6}.reset-card .btn-danger{margin-top:10px}
</style>
</head>

<body>
<div class="app">
<aside class="sidebar" id="sidebar">
  <div class="brand">
    <div class="brand-main"><div class="tree-avatar">🌳</div> GambutWatch</div>
    <small>Sistem Monitoring Restorasi Ekosistem Gambut<br>Kecamatan Teluk Pakedai • Kubu Raya</small>
    <div class="brand-credit"><span>🌿</span> Design by <strong>Andri Himawan</strong></div>
  </div>
  <div class="nav">
    <div class="nav-group">Utama</div>
    <button class="active" data-page="dashboard"><span class="ico">▦</span> Dashboard</button>
    <button data-page="input"><span class="ico">＋</span> Input Laporan</button>
    <button data-page="monitoring"><span class="ico">▤</span> Data Monitoring</button>
    <button data-page="map"><span class="ico">⌖</span> Peta Monitoring</button>
    <button data-page="docs"><span class="ico">▧</span> Dokumentasi</button>
    <button onclick="exportExcel()"><span class="ico">⇩</span> Unduh Data</button>
    <div class="nav-group">Analitik</div>
    <button data-page="reports"><span class="ico">◒</span> Laporan & Analitik</button>
    <div class="nav-group">Sistem</div>
    <button data-page="settings"><span class="ico">⚙</span> Pengaturan</button>
  </div>
  <div class="sidebar-footer">
    Monitoring • Restorasi • Masa Depan<br>
    Sistem monitoring ekosistem gambut berbasis digital.
  </div>

</aside>

<section class="main">
<header class="topbar">
  <div style="display:flex;align-items:center;gap:11px">
    <button class="icon-btn mobile-menu" id="mobileMenu">☰</button>
    <div>
      <div class="page-title" id="topTitle">Dashboard Monitoring</div>
      <div class="page-sub">Teluk Pakedai, Kabupaten Kubu Raya, Kalimantan Barat</div>
    </div>
  </div>
  <div class="top-actions">
    <button class="icon-btn" onclick="refreshAll()" title="Refresh">↻</button>
    <button class="icon-btn" onclick="showToast('Notifikasi: laporan perlu diperiksa.')" title="Notifikasi">🔔</button>
    <div class="user-pill"><div class="avatar">A</div><span class="user-name" style="font-size:11px;font-weight:800">Administrator</span></div>
  </div>
</header>

<main class="content">

<!-- DASHBOARD -->
<section class="page active dashboard-ref" id="page-dashboard">
  <div class="peat-monitor-watermark" aria-hidden="true"><span>PEATLAND</span><b>MONITORING</b><small>TELUK PAKEDAI • KUBU RAYA</small></div>
  <div class="welcome-strip">
    <div class="welcome-title">
      <div class="welcome-icon" aria-label="Ikon ekosistem gambut">
        <svg viewBox="0 0 48 48" width="25" height="25" aria-hidden="true">
          <path d="M24 39V22" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
          <path d="M24 27c-7-1-11-5-12-12 7 0 12 3 12 10" fill="currentColor" opacity=".95"/>
          <path d="M25 23c1-7 5-11 12-12 0 7-4 12-12 12" fill="currentColor" opacity=".72"/>
          <path d="M24 38c-4 0-7-2-9-5 4-1 7 0 9 3 2-3 5-4 9-3-2 3-5 5-9 5Z" fill="currentColor" opacity=".58"/>
        </svg>
      </div>
      <div>
        <h1>Selamat Datang, Admin</h1>
        <p>Dashboard Monitoring Ekosistem Gambut</p>
      </div>
    </div>
    <div class="info-strip">
      <div class="info-box"><div class="ii">📍</div><div><b>Kecamatan Teluk Pakedai</b><span>Kabupaten Kubu Raya</span></div></div>
      <div class="info-box"><div class="ii">▦</div><div><b id="dashDate">Rabu, 14 Mei 2025</b><span id="dashClock">10:20 WIB</span></div></div>
      <div class="info-box weather"><div class="ii">🌤️</div><div><strong id="weatherTemp">31.8°C</strong><span>Berawan</span></div></div>
    </div>
  </div>

  <div class="grid-kpi kpi-ref">
    <div class="kpi blue"><div class="kpi-top">Total Laporan <span class="kpi-icon">▤</span></div><div class="kpi-value" id="kpiTotal">0</div><div class="kpi-note">Data semua lokasi</div><div class="trend up">↑ 12%</div></div>
    <div class="kpi green"><div class="kpi-top">AMAN <span class="kpi-icon">✓</span></div><div class="kpi-value" id="kpiAman">0</div><div class="kpi-note" id="amanPct">— dari total</div><div class="trend up">↑ 8%</div></div>
    <div class="kpi yellow"><div class="kpi-top">WASPADA <span class="kpi-icon">!</span></div><div class="kpi-value" id="kpiWaspada">0</div><div class="kpi-note" id="waspadaPct">— dari total</div><div class="trend flat">→ 0%</div></div>
    <div class="kpi red"><div class="kpi-top">DARURAT <span class="kpi-icon">!</span></div><div class="kpi-value" id="kpiDarurat">0</div><div class="kpi-note" id="daruratPct">— dari total</div><div class="trend up">↑ 2%</div></div>
    <div class="kpi blue"><div class="kpi-top">Rata-rata TMAT <span class="kpi-icon">💧</span></div><div class="kpi-value" id="kpiMat">—</div><div class="kpi-note">dari laporan tersaring</div><div class="trend down">↓ 6%</div></div>
    <div class="kpi"><div class="kpi-top">Rata-rata Suhu <span class="kpi-icon">♨</span></div><div class="kpi-value" id="kpiTemp">—</div><div class="kpi-note">dari laporan tersaring</div><div class="trend up">↑ 1%</div></div>
  </div>

  <div class="panel-row">
    <div class="card">
      <div class="card-title"><h2>Perubahan TMAT (Tinggi Muka Air Tanah)</h2><span>7 Hari Terakhir⌄</span></div>
      <div class="chart-wrap" id="tmatChart"></div>
    </div>
    <div class="card">
      <div class="card-title"><h2>Status Monitoring</h2><span>Distribusi</span></div>
      <div class="status-mini" id="statusBars"></div>
    </div>
    <div class="card">
      <div class="card-title"><h2>📍 Peta Lokasi Monitoring</h2><button class="btn btn-secondary" onclick="navigate('map')">Buka Peta</button></div>
      <div id="dashMap" class="map"></div>
    </div>
  </div>

  <div class="lower-row">
    <div class="card">
      <div class="card-title"><h2>▤ Laporan Monitoring Terbaru</h2><button class="btn btn-secondary" onclick="navigate('monitoring')">Lihat Semua →</button></div>
      <div class="table-wrap"><table><thead><tr><th>No.</th><th>ID Laporan</th><th>Lokasi</th><th>Kecamatan</th><th>Waktu</th><th>TMAT</th><th>Suhu</th><th>Vegetasi</th><th>Asap</th><th>Api</th><th>Status</th><th>Aksi</th></tr></thead><tbody id="latestTable"></tbody></table></div>
    </div>
    <div class="card">
      <div class="card-title"><h2>▣ Dokumentasi Terbaru</h2><button class="btn btn-secondary" onclick="navigate('docs')">Lihat Semua →</button></div>
      <div class="doc-row">
        <div class="doc-mini">💧<div>Foto Rambu Ukur TMAT<small>2025-05-12 08:15</small></div></div>
        <div class="doc-mini">🌿<div>Foto Vegetasi dan Ekosistem<small>2025-05-12 10:20</small></div></div>
        <div class="doc-mini">🌫️<div>Foto Asap<small>2025-05-12 13:10</small></div></div>
        <div class="doc-mini">▶<div>Video Situasi Lapangan<small>2025-05-12 13:10</small></div></div>
      </div>
    </div>
  </div>

  <div class="bottom-row">
    <div class="card">
      <div class="card-title"><h2>🛡 Ringkasan Status Hari Ini</h2><span>Kondisi operasional</span></div>
      <div class="status-summary">
        <div class="summary-left"><span style="font-size:10px">Kondisi wilayah secara umum dalam kategori</span><span class="summary-badge" id="summaryStatus">AMAN</span></div>
        <div class="summary-items">
          <div class="summary-item"><b>🟢 Aman <span id="sumAman">0 lokasi</span></b></div>
          <div class="summary-item"><b>🟡 Waspada <span id="sumWaspada">0 lokasi</span></b></div>
          <div class="summary-item"><b>🔴 Darurat <span id="sumDarurat">0 lokasi</span></b></div>
        </div>
      </div>
    </div>
    <div class="card">
      <div class="card-title"><h2>Quick Action</h2><span>Menu cepat</span></div>
      <div class="quick-actions">
        <button class="quick-action" onclick="navigate('input')"><div>⊕</div>Tambah Laporan</button>
        <button class="quick-action" onclick="navigate('map')"><div>⌖</div>Lihat Peta</button>
        <button class="quick-action" onclick="navigate('monitoring')"><div>▤</div>Lihat Laporan</button>
        <button class="quick-action" onclick="exportExcel()"><div>⇩</div>Unduh Data</button>
      </div>
    </div>
  </div>
</section>

<!-- INPUT -->
<section class="page" id="page-input">
  <div class="hero"><h1>Input Laporan Monitoring</h1><p>Form digital untuk pencatatan pengamatan lapangan. Data disimpan pada perangkat dan dapat dikirim ke server jika koneksi tersedia.</p></div>

  <div class="card">
    <div class="card-title"><h2>Identitas Pengamatan</h2><span>Data wajib ditandai *</span></div>
    <div class="form-grid">
      <div class="field"><label>Kabupaten <span class="req">*</span></label><select id="fKab" required><option value="Kabupaten Kubu Raya">Kabupaten Kubu Raya</option></select></div>
      <div class="field"><label>Kecamatan <span class="req">*</span></label><select id="fKec" required><option value="Teluk Pakedai">Teluk Pakedai</option><option value="Kubu">Kubu</option><option value="Sungai Kakap">Sungai Kakap</option></select></div>
      <div class="field"><label>Nama Petugas</label><input id="fPetugas" placeholder="Nama petugas lapangan"></div>
      <div class="field"><label>ID Laporan</label><input id="fId" readonly></div>
      <div class="field"><label>Lokasi GPS <span class="req">*</span></label><div class="gps-row"><input id="fGps" readonly placeholder="Belum diambil"><button class="btn btn-secondary" type="button" onclick="ambilGPS()">📍 Ambil GPS</button></div></div>
      <div class="field"><label>Waktu <span class="req">*</span></label><input id="fWaktu" readonly></div>
    </div>
  </div>

  <div class="card">
    <div class="card-title"><h2>Pengukuran Gambut</h2><span>Parameter lingkungan</span></div>
    <div class="form-grid">
      <div class="field"><label>Tinggi Muka Air Tanah Gambut (cm) <span class="req">*</span></label><input id="fMat" type="number" step="0.1" placeholder="Contoh: -55"></div>
      <div class="field"><label>Suhu (°C) <span class="req">*</span></label><input id="fSuhu" type="number" step="0.1" placeholder="Contoh: 32.5"></div>
      <div class="field full"><label>Kondisi Vegetasi / Ekosistem</label><textarea id="fVegetasi" placeholder="Contoh: vegetasi relatif baik, semak dan pohon rawa dominan..."></textarea></div>
      <div class="field"><label>Apakah Ada Api? <span class="req">*</span></label><select id="fApi"><option value="">Pilih</option><option value="tidak">Tidak</option><option value="ada">Ada</option></select></div>
      <div class="field"><label>Apakah Ada Asap? <span class="req">*</span></label><select id="fAsap"><option value="">Pilih</option><option value="tidak">Tidak</option><option value="ada">Ada</option></select></div>
    </div>
  </div>

  <div class="card">
    <div class="card-title"><h2>Dokumentasi Lapangan</h2><span>Foto dan video</span></div>
    <div class="upload-grid">
      <div class="upload-box photo-card" id="photoCardTMAT">
        <label>Foto Rambu Ukur TMAT <span class="req">*</span></label>
        <button type="button" class="btn btn-primary" onclick="openCamera('TMAT')">📷 Ambil Foto</button>
        <div id="photoMetaTMAT" class="media-meta">Belum ada foto. Ambil foto langsung dari kamera.</div>
        <img id="pFotoMat" class="preview" alt="Preview Foto Rambu Ukur TMAT">
        <div id="photoActionsTMAT" class="photo-actions" style="display:none">
          <button type="button" class="btn btn-light" onclick="retakePhoto('TMAT')">🔄 Ambil Ulang</button>
          <button type="button" class="btn btn-danger" onclick="removePhoto('TMAT')">🗑️ Hapus</button>
        </div>
      </div>
      <div class="upload-box photo-card" id="photoCardVegetasi">
        <label>Foto Vegetasi & Ekosistem <span class="req">*</span></label>
        <button type="button" class="btn btn-primary" onclick="openCamera('Vegetasi')">📷 Ambil Foto</button>
        <div id="photoMetaVegetasi" class="media-meta">Belum ada foto. Ambil foto langsung dari kamera.</div>
        <img id="pFotoVeg" class="preview" alt="Preview Foto Vegetasi & Ekosistem">
        <div id="photoActionsVegetasi" class="photo-actions" style="display:none">
          <button type="button" class="btn btn-light" onclick="retakePhoto('Vegetasi')">🔄 Ambil Ulang</button>
          <button type="button" class="btn btn-danger" onclick="removePhoto('Vegetasi')">🗑️ Hapus</button>
        </div>
      </div>
      <div class="upload-box photo-card" id="photoCardAsap">
        <label>Foto Asap Jika Ada</label>
        <button type="button" class="btn btn-primary" onclick="openCamera('Asap')">📷 Ambil Foto</button>
        <div id="photoMetaAsap" class="media-meta">Opsional — ambil foto jika terdapat asap.</div>
        <img id="pFotoAsap" class="preview" alt="Preview Foto Asap">
        <div id="photoActionsAsap" class="photo-actions" style="display:none">
          <button type="button" class="btn btn-light" onclick="retakePhoto('Asap')">🔄 Ambil Ulang</button>
          <button type="button" class="btn btn-danger" onclick="removePhoto('Asap')">🗑️ Hapus</button>
        </div>
      </div>
    </div>
    <div style="margin-top:12px" class="upload-box"><label>Video Situasi Lapangan</label><input id="fVideo" type="file" accept="video/*" capture="environment" onchange="previewFile('fVideo','pVideo')"><video id="pVideo" class="video-preview" controls></video></div>
  </div>

  <div class="card">
    <div class="card-title"><h2>Status Monitoring</h2><span>Aturan operasional</span></div>
    <div id="formStatus" class="status-preview">Lengkapi TMAT dan indikator asap/api</div>
    <div class="callout" style="margin-top:10px">Status AMAN/WASPADA/DARURAT pada sistem ini adalah klasifikasi operasional untuk monitoring, bukan indeks kerentanan iklim yang tervalidasi.</div>
  </div>

  <div class="card no-print">
    <div class="form-actions">
      <button class="btn btn-primary" onclick="saveReport()">💾 Simpan Laporan</button>
      <button class="btn btn-secondary" onclick="resetForm()">↺ Reset</button>
      <button class="btn btn-light" onclick="navigate('dashboard')">Dashboard</button>
    </div>
  </div>
</section>

<!-- MONITORING -->
<section class="page" id="page-monitoring">
  <div class="hero"><h1>Data Monitoring</h1><p>Kelola, cari, filter, ekspor, dan tinjau seluruh laporan monitoring yang tersimpan.</p></div>
  <div class="card">
    <div class="search-row">
      <input id="tableSearch" placeholder="Cari ID, petugas, kecamatan, status..." oninput="renderMonitoring()">
      <select id="tableStatus" onchange="renderMonitoring()"><option value="">Semua Status</option><option>AMAN</option><option>WASPADA</option><option>DARURAT</option></select>
      <button class="btn btn-secondary" onclick="exportCSV()">⬇ Export CSV</button>
      <button class="btn btn-danger" onclick="deleteAll()">🗑 Hapus Semua Data</button>
    </div>
    <div class="table-wrap"><table><thead><tr><th>ID</th><th>Waktu</th><th>Kecamatan</th><th>Petugas</th><th>GPS</th><th>TMAT</th><th>Suhu</th><th>Vegetasi</th><th>Asap</th><th>Api</th><th>Status</th><th>Aksi</th></tr></thead><tbody id="monitorTable"></tbody></table></div>
  </div>
</section>

<!-- MAP -->
<section class="page" id="page-map">
  <div class="hero"><h1>Peta Monitoring</h1><p>Peta geografis berpusat di Kecamatan Teluk Pakedai. Titik monitoring ditampilkan berdasarkan data yang tersimpan.</p></div>
  <div class="filters">
    <div class="filter-box"><label>Status</label><select id="mapStatus" onchange="renderMapMarkers()"><option value="">Semua</option><option>AMAN</option><option>WASPADA</option><option>DARURAT</option></select></div>
    <button class="btn btn-secondary" onclick="centerTelukPakedai()">⌖ Fokus Teluk Pakedai</button>
  </div>
  <div class="card"><div id="mainMap" class="map" style="height:560px"></div></div>
  <div class="two-col">
    <div class="card"><div class="card-title"><h2>Legenda</h2><span>Titik monitoring</span></div>
      <div class="legend" style="font-size:11px"><span><i style="background:#23834b"></i> AMAN</span><span><i style="background:#c98900"></i> WASPADA</span><span><i style="background:#b52b2b"></i> DARURAT</span></div>
      <p class="mini-muted" style="line-height:1.6;margin-top:12px">Peta menggunakan Leaflet. Koordinat pusat Teluk Pakedai digunakan sebagai titik awal tampilan. Titik laporan berasal dari GPS perangkat pada saat input.</p>
    </div>
    <div class="card"><div class="card-title"><h2>Ringkasan Lokasi</h2><span id="mapCount">0 titik</span></div><div id="mapSummary"></div></div>
  </div>
</section>

<!-- DOCUMENTATION -->
<section class="page" id="page-docs">
  <div class="hero"><h1>Dokumentasi Lapangan</h1><p>Kumpulan dokumentasi foto dan video yang terkait dengan laporan monitoring.</p></div>
  <div class="filters"><div class="filter-box"><label>Jenis</label><select id="docType" onchange="renderDocs()"><option value="">Semua</option><option value="TMAT">Rambu TMAT</option><option value="Vegetasi">Vegetasi</option><option value="Asap">Asap</option><option value="Video">Video</option></select></div><input id="docSearch" style="max-width:360px" placeholder="Cari dokumentasi..." oninput="renderDocs()"></div>
  <div class="doc-grid" id="docGrid"></div>
</section>

<!-- REPORTS -->
<section class="page" id="page-reports">
  <div class="hero"><h1>Laporan & Analitik</h1><p>Ringkasan statistik untuk membantu monitoring dan evaluasi berdasarkan data monitoring yang tersimpan.</p></div>
  <div class="report-grid">
    <div class="card"><div class="card-title"><h2>Ringkasan Monitoring</h2><span>Data tersaring</span></div><div class="metric-list" id="reportMetrics"></div></div>
    <div class="card"><div class="card-title"><h2>Indikator Lingkungan</h2><span>Rata-rata</span></div><div class="metric-list" id="envMetrics"></div></div>
  </div>
  <div class="report-chart-grid">
    <div class="card"><div class="card-title"><h2>Tren TMAT</h2><span>Data monitoring</span></div><div id="reportChart"></div></div>
    <div class="card"><div class="card-title"><h2>Status Monitoring</h2><span>Jumlah laporan</span></div><div id="reportStatusChart"></div></div>
    <div class="card"><div class="card-title"><h2>Tren Suhu</h2><span>Data monitoring</span></div><div id="reportTempChart"></div></div>
    <div class="card"><div class="card-title"><h2>Catatan Interpretasi</h2><span>Monitoring</span></div>
      <div class="callout">Data monitoring digunakan sebagai dokumentasi kondisi lapangan, pemantauan perubahan dari waktu ke waktu, dan bahan analisis lanjutan. Status AMAN/WASPADA/DARURAT merupakan klasifikasi operasional monitoring.</div>
      <div class="export-actions"><button class="btn btn-primary" onclick="printReport()">🖨 Cetak / Simpan PDF</button><button class="btn btn-secondary" onclick="exportExcel()">📊 Unduh Excel</button><button class="btn btn-secondary" onclick="exportCSV()">⬇ Unduh CSV</button></div>
    </div>
  </div>
</section>

