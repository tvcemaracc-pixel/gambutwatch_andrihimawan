.grid-kpi{display:grid;grid-template-columns:repeat(6,1fr);gap:12px;margin:16px 0}
.kpi{background:#fff;border:1px solid var(--line);border-radius:15px;padding:15px;box-shadow:0 4px 18px rgba(0,0,0,.04)}
.kpi-top{display:flex;justify-content:space-between;align-items:center;color:var(--muted);font-size:11px;font-weight:800}
.kpi-icon{width:34px;height:34px;border-radius:10px;display:grid;place-items:center;background:var(--green-100)}
.kpi-value{font-size:25px;font-weight:900;margin-top:10px}
.kpi-note{font-size:10px;color:var(--muted);margin-top:4px}
.kpi.green .kpi-icon{background:#e0f4e5}.kpi.yellow .kpi-icon{background:#fff1c5}.kpi.red .kpi-icon{background:#ffe1e1}.kpi.blue .kpi-icon{background:#e5efff}
.two-col{display:grid;grid-template-columns:1.55fr 1fr;gap:14px}
.card{background:#fff;border:1px solid var(--line);border-radius:16px;padding:18px;box-shadow:0 4px 18px rgba(0,0,0,.04);margin-bottom:14px}
.card-title{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:13px}
.card-title h2{font-size:14px;margin:0;font-weight:900}
.card-title span{font-size:10px;color:var(--muted)}
.chart-wrap{width:100%;overflow:hidden}
.chart-wrap svg{width:100%;height:auto;display:block}
.legend{display:flex;gap:14px;flex-wrap:wrap;margin-top:8px;font-size:10px;color:var(--muted)}
.legend i{display:inline-block;width:9px;height:9px;border-radius:3px;margin-right:4px}
.map{height:420px;border-radius:13px;overflow:hidden;border:1px solid var(--line)}
.map.small{height:330px}
.status-list{display:grid;gap:9px}
.status-row{display:grid;grid-template-columns:92px 1fr 42px;gap:10px;align-items:center;font-size:11px}
.bar{height:9px;background:#edf2ee;border-radius:99px;overflow:hidden}
.bar > span{height:100%;display:block;border-radius:99px}
.status-aman{color:#19733a}.status-waspada{color:#986600}.status-darurat{color:#ae2626}
.table-wrap{overflow:auto;border:1px solid var(--line);border-radius:12px}
table{width:100%;border-collapse:collapse;min-width:980px}
th,td{padding:11px 12px;border-bottom:1px solid #edf1ee;text-align:left;vertical-align:top;font-size:11px}
th{background:#f5f8f5;color:#5e6b62;text-transform:uppercase;letter-spacing:.04em;font-size:9px}
tr:hover td{background:#fbfdfb}
.badge{display:inline-flex;align-items:center;padding:5px 8px;border-radius:999px;font-size:9px;font-weight:900}
.badge.aman{background:#dff2e4;color:#1a733a}.badge.waspada{background:#fff0c7;color:#876000}.badge.darurat{background:#ffe0e0;color:#aa2525}
.mini-muted{font-size:10px;color:var(--muted)}
.form-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}
.field{display:flex;flex-direction:column;gap:6px}
.field.full{grid-column:1/-1}
.field label{font-size:11px;font-weight:900}
.req{color:var(--red)}
input,select,textarea{width:100%;border:1px solid #d7e2da;border-radius:10px;padding:11px 12px;outline:none;background:#fff;color:var(--ink);font-size:12px}
input:focus,select:focus,textarea:focus{border-color:#6aa87c;box-shadow:0 0 0 3px #e7f4eb}
input[readonly]{background:#f5f8f5}
textarea{min-height:100px;resize:vertical}
.gps-row{display:grid;grid-template-columns:1fr auto;gap:8px}
.upload-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.upload-box{border:1px dashed #b8cbbd;background:#fbfdfb;border-radius:12px;padding:12px}
.upload-box > label{display:block;font-size:13px;line-height:1.35;font-weight:800;color:var(--ink);margin-bottom:9px}
.upload-box input{border:0;padding:7px 0}
.media-meta{font-size:10px;color:#6c7d72;margin-top:8px;line-height:1.45}.camera-note{font-size:12px;color:#607267;margin-top:6px}.camera-modal{position:fixed;inset:0;background:rgba(2,20,13,.78);display:none;align-items:center;justify-content:center;z-index:9999;padding:18px}.camera-modal.open{display:flex}.camera-panel{width:min(620px,96vw);background:#fff;border-radius:20px;overflow:hidden;box-shadow:0 20px 70px rgba(0,0,0,.35)}.camera-head{padding:14px 18px;background:#0b4b32;color:#fff;display:flex;justify-content:space-between;align-items:center}.camera-stage{background:#07150f;padding:12px}.camera-stage video{width:100%;max-height:62vh;object-fit:cover;border-radius:12px;background:#000}.camera-actions{display:flex;gap:10px;justify-content:center;padding:14px}.camera-actions .btn{font-size:12px}
.photo-actions{display:flex;gap:8px;margin-top:9px;flex-wrap:wrap}
.photo-actions .btn{font-size:11px;padding:7px 10px}
.btn-danger{background:#b42318!important;color:#fff!important;border-color:#b42318!important}
.photo-card .preview{margin-top:9px}
@media(max-width:700px){
  .photo-actions{gap:7px}
  .photo-actions .btn{font-size:11px;padding:7px 9px}
}
.camera-gps{padding:0 18px 10px;color:#53655b;font-size:12px}
.preview{width:100%;height:145px;object-fit:cover;border-radius:9px;display:none;margin-top:8px;background:#edf3ee}
.video-preview{width:100%;max-height:230px;border-radius:9px;display:none;margin-top:8px}
.status-preview{padding:15px;border-radius:12px;text-align:center;font-weight:900;font-size:18px;background:#f0f4f1}
.status-preview.aman{background:#dff2e4;color:#1a733a}.status-preview.waspada{background:#fff0c7;color:#876000}.status-preview.darurat{background:#ffe0e0;color:#aa2525}
.form-actions{display:flex;gap:9px;flex-wrap:wrap}
.search-row{display:flex;gap:9px;flex-wrap:wrap;margin-bottom:13px}
.search-row input{max-width:360px}
.doc-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:13px}
.doc-card{background:#fff;border:1px solid var(--line);border-radius:14px;overflow:hidden}
.doc-media{height:145px;background:linear-gradient(135deg,#d9eadc,#9fbea7);display:grid;place-items:center;color:#285436;font-size:36px}
.doc-body{padding:12px}
.doc-title{font-size:11px;font-weight:900}.doc-meta{font-size:9px;color:var(--muted);margin-top:5px;line-height:1.5}
.report-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.report-box{border:1px solid var(--line);border-radius:12px;padding:14px;background:#fbfdfb}
.report-box h3{margin:0 0 8px;font-size:12px}
.metric-list{display:grid;gap:8px}
.metric{display:flex;justify-content:space-between;font-size:11px;border-bottom:1px dashed #dfe8e1;padding-bottom:7px}
.callout{border-left:4px solid var(--green-700);background:var(--green-50);padding:12px 14px;border-radius:10px;font-size:11px;line-height:1.6}
.settings-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.toggle-row{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #edf1ee;padding:11px 0;font-size:11px}
.switch{width:42px;height:24px;background:#cbd6ce;border-radius:999px;padding:3px}
.switch span{display:block;width:18px;height:18px;border-radius:50%;background:#fff;transition:.2s}
.switch.on{background:var(--green-700)}.switch.on span{transform:translateX(18px)}
.empty{padding:28px;text-align:center;color:var(--muted);font-size:12px}
.footer{text-align:center;color:#819087;font-size:10px;padding:18px}
.mobile-menu{display:none}
.toast{position:fixed;right:20px;bottom:20px;background:#123b23;color:#fff;padding:12px 15px;border-radius:12px;box-shadow:0 15px 30px rgba(0,0,0,.18);font-size:11px;z-index:100;display:none;max-width:360px}
.print-only{display:none}
@media(max-width:1200px){
  .grid-kpi{grid-template-columns:repeat(3,1fr)}
  .doc-grid{grid-template-columns:repeat(2,1fr)}
}
@media(max-width:900px){
  .sidebar{transform:translateX(-100%);transition:.2s}.sidebar.open{transform:none}
  .main{margin-left:0;width:100%}.mobile-menu{display:block}
  .topbar{padding:0 14px}.content{padding:15px}.two-col,.report-grid,.settings-grid{grid-template-columns:1fr}
}
@media(max-width:680px){
  .grid-kpi{grid-template-columns:repeat(2,1fr)}
  .form-grid,.upload-grid{grid-template-columns:1fr}.field.full{grid-column:auto}
  .hero-row{display:block}.hero h1{font-size:21px}.hero{padding:19px}
  .topbar .page-sub{display:none}.user-pill .user-name{display:none}
  .doc-grid{grid-template-columns:1fr}
  .map{height:330px}
  .upload-box > label{font-size:14px;line-height:1.35;margin-bottom:9px}
  .media-meta{font-size:10px}
}
@media print{
  .sidebar,.topbar,.filters,.no-print,.toast{display:none!important}
  .main{margin:0;width:100%}.content{padding:0}
  .page{display:none!important}.page.print-page{display:block!important}
  .print-only{display:block}.card{box-shadow:none}
}


