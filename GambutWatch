.sidebar-footer{padding:14px 16px;border-top:1px solid rgba(255,255,255,.12);font-size:10px;color:#a9c5b2;line-height:1.5}
.main{margin-left:293px;width:calc(100% - 293px);min-width:0;position:relative;background:
