  linear-gradient(120deg,transparent 0 35%,rgba(25,104,66,.035) 35.2% 35.5%,transparent 35.7% 100%);z-index:0}
.main:after{content:"GAMBUT • MONITORING • RESTORASI";position:absolute;right:34px;bottom:70px;font-size:11px;font-weight:900;letter-spacing:.28em;color:rgba(17,91,57,.065);transform:rotate(-12deg);pointer-events:none;z-index:0}
.topbar{height:72px;background:#fff;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 28px;position:sticky;top:0;z-index:30}
