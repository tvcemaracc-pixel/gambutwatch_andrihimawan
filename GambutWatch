.hero-row{display:flex;justify-content:space-between;gap:20px;align-items:flex-end}
.hero-stat{display:flex;gap:8px;flex-wrap:wrap;margin-top:17px}
.hero-tag{padding:7px 10px;border:1px solid rgba(255,255,255,.17);background:rgba(255,255,255,.09);border-radius:9px;font-size:11px}
.filters{display:flex;gap:10px;flex-wrap:wrap;margin:16px 0}
.filter-box{background:#fff;border:1px solid var(--line);border-radius:12px;padding:9px 11px;display:flex;align-items:center;gap:8px;box-shadow:0 3px 12px rgba(0,0,0,.03)}
.filter-box label{font-size:10px;text-transform:uppercase;color:var(--muted);font-weight:800}
