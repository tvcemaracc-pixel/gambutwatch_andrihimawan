<script>
const KEY='gambutwatch_modern_v1';
const WEB_APP_URL='https://script.google.com/macros/s/AKfycbyQyWRaWB0ONWdFt-QJK9jFArJko8iMvF1Ba7N5b5mg7YGhZxWzYk5nkiNlWsng9KSf/exec';
const TELUK=[-0.315,109.152];
const $=id=>document.getElementById(id);

const pageTitles={
 dashboard:'Dashboard Monitoring',input:'Input Laporan',monitoring:'Data Monitoring',
 map:'Peta Monitoring',docs:'Dokumentasi Lapangan',reports:'Laporan & Analitik',settings:'Pengaturan'
};

let dashMap=null,mainMap=null,dashLayer=null,mainLayer=null;
let cameraStream=null,cameraType=null,cameraGps=null,pendingMedia={};
const MEDIA_DB='gambutwatch_media_v2';
function openMediaDB(){return new Promise((resolve,reject)=>{const req=indexedDB.open(MEDIA_DB,1);req.onupgradeneeded=()=>{if(!req.result.objectStoreNames.contains('media'))req.result.createObjectStore('media',{keyPath:'key'});};req.onsuccess=()=>resolve(req.result);req.onerror=()=>reject(req.error);});}
async function saveMedia(key,blob,meta){const db=await openMediaDB();return new Promise((resolve,reject)=>{const tx=db.transaction('media','readwrite');tx.objectStore('media').put({key,blob,meta});tx.oncomplete=()=>{db.close();resolve()};tx.onerror=()=>{db.close();reject(tx.error)}})}
async function getMedia(key){try{const db=await openMediaDB();return await new Promise((resolve,reject)=>{const req=db.transaction('media').objectStore('media').get(key);req.onsuccess=()=>{db.close();resolve(req.result||null)};req.onerror=()=>{db.close();reject(req.error)}})}catch(e){return null}}
async function deleteReportMedia(reportId){try{const db=await openMediaDB();const tx=db.transaction('media','readwrite'),store=tx.objectStore('media');['TMAT','Vegetasi','Asap','Video'].forEach(x=>store.delete(reportId+'_'+x));}catch(e){}}
async function openCamera(type){
  cameraType=type;
  cameraGps=null;
  $('cameraModal').classList.add('open');
  $('cameraGps').textContent='Menyiapkan kamera dan GPS...';

  // Browser hanya mengizinkan getUserMedia pada HTTPS/localhost.
  if(!window.isSecureContext || !navigator.mediaDevices?.getUserMedia){
    $('cameraGps').textContent='Kamera web membutuhkan HTTPS atau localhost.';
    showToast('Buka GambutWatch melalui HTTPS/localhost. File .html langsung dari Downloads tidak dapat mengakses kamera.');
    return;
  }

  try{
    cameraStream=await navigator.mediaDevices.getUserMedia({
      video:{facingMode:{ideal:'environment'},width:{ideal:1920},height:{ideal:1080}},
      audio:false
    });
    $('cameraVideo').srcObject=cameraStream;
    await $('cameraVideo').play().catch(()=>{});
  }catch(e){
    console.error('getUserMedia:',e);
    $('cameraGps').textContent='Kamera tidak tersedia atau izin kamera ditolak.';
    showToast('Kamera tidak dapat dibuka. Izinkan kamera pada browser.');
    return;
  }

  if(navigator.geolocation){
    navigator.geolocation.getCurrentPosition(
      p=>{
        cameraGps={lat:p.coords.latitude,lon:p.coords.longitude,accuracy:p.coords.accuracy};
        const gpsText=`${p.coords.latitude.toFixed(6)}, ${p.coords.longitude.toFixed(6)}`;
        $('cameraGps').textContent=`GPS: ${gpsText} • Akurasi ±${Math.round(p.coords.accuracy)} m`;
        if(!$('fGps').value || $('fGps').value==='Mengambil GPS...') $('fGps').value=gpsText;
      },
      ()=>{
        cameraGps=null;
        $('cameraGps').textContent='GPS gagal diambil. Izinkan lokasi untuk mengambil foto.';
        showToast('GPS belum tersedia. Aktifkan izin lokasi lalu coba lagi.');
      },
      {enableHighAccuracy:true,timeout:15000,maximumAge:0}
    );
  }else{
    $('cameraGps').textContent='Browser tidak mendukung GPS.';
  }
}

const photoUiMap={
  TMAT:{img:'pFotoMat',meta:'photoMetaTMAT',actions:'photoActionsTMAT',empty:'Belum ada foto. Ambil foto langsung dari kamera.'},
  Vegetasi:{img:'pFotoVeg',meta:'photoMetaVegetasi',actions:'photoActionsVegetasi',empty:'Belum ada foto. Ambil foto langsung dari kamera.'},
  Asap:{img:'pFotoAsap',meta:'photoMetaAsap',actions:'photoActionsAsap',empty:'Opsional — ambil foto jika terdapat asap.'}
};

function refreshPhotoUI(type){
  const m=photoUiMap[type], media=pendingMedia[type];
  if(!m)return;
  const img=$(m.img), meta=$(m.meta), actions=$(m.actions);
  if(media?.blob){
    img.style.display='block';
    actions.style.display='flex';
    meta.textContent=`✓ Foto tersimpan • GPS ${media.gps.lat.toFixed(6)}, ${media.gps.lon.toFixed(6)} • ${new Date(media.time).toLocaleString('id-ID')}`;
  }else{
    img.removeAttribute('src');
    img.style.display='none';
    actions.style.display='none';
    meta.textContent=m.empty;
  }
}

function retakePhoto(type){
  openCamera(type);
}

async function removePhoto(type){
  const media=pendingMedia[type];
  if(!media){
    refreshPhotoUI(type);
    return;
  }
  if(!confirm('Hapus foto ini? Foto akan dihapus dari penyimpanan lokal dan Anda dapat mengambil foto baru.')) return;
  await deleteMedia(media.key);
  pendingMedia[type]=null;
  refreshPhotoUI(type);
  showToast('Foto dihapus. Silakan ambil foto baru jika diperlukan.');
}

async function capturePhoto(){
  if(!cameraStream||!cameraType){return}
  if(!cameraGps){showToast('Tunggu GPS berhasil diperoleh sebelum mengambil foto.');return}
  const v=$('cameraVideo'),c=$('cameraCanvas');
  c.width=v.videoWidth||1280;c.height=v.videoHeight||720;
  const ctx=c.getContext('2d');
  ctx.drawImage(v,0,0,c.width,c.height);
  ctx.fillStyle='rgba(0,40,25,.72)';
  ctx.fillRect(0,c.height-58,c.width,58);
  ctx.fillStyle='#fff';
  ctx.font='bold 18px Arial';
  ctx.fillText(`GambutWatch • ${cameraGps.lat.toFixed(6)}, ${cameraGps.lon.toFixed(6)}`,18,c.height-32);
  ctx.font='14px Arial';
  const capturedAt=new Date();
  ctx.fillText(capturedAt.toLocaleString('id-ID'),18,c.height-12);

  const blob=await new Promise(r=>c.toBlob(r,'image/jpeg',0.88));
  if(!$('fId').value) $('fId').value=idBaru();
  if(!$('fWaktu').value) $('fWaktu').value=nowText();
  if(cameraGps && (!$('fGps').value || $('fGps').value==='Mengambil GPS...')){
    $('fGps').value=`${cameraGps.lat.toFixed(6)}, ${cameraGps.lon.toFixed(6)}`;
  }
  const reportId=$('fId').value;
  const key=reportId+'_'+cameraType;

  // Jika mengambil ulang, hapus media lama lebih dulu.
  const oldMedia=pendingMedia[cameraType];
  if(oldMedia?.key && oldMedia.key!==key) await deleteMedia(oldMedia.key);

  pendingMedia[cameraType]={blob,key,gps:cameraGps,time:capturedAt.toISOString()};
  await saveMedia(key,blob,{type:cameraType,gps:cameraGps,time:capturedAt.toISOString(),reportId});

  const imgId={TMAT:'pFotoMat',Vegetasi:'pFotoVeg',Asap:'pFotoAsap'}[cameraType];
  $(imgId).src=URL.createObjectURL(blob);
  $(imgId).style.display='block';
  refreshPhotoUI(cameraType);

  closeCamera();
  showToast('Foto berhasil diambil dan direkam bersama GPS.');
}
// Waktu penelitian menggunakan zona WIB (Asia/Jakarta) agar konsisten dengan Teluk Pakedai.
function waktuWIB(){
 const parts=new Intl.DateTimeFormat('en-CA',{timeZone:'Asia/Jakarta',year:'numeric',month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit',second:'2-digit',hourCycle:'h23'}).formatToParts(new Date());
 const o={}; parts.forEach(x=>{if(x.type!=='literal')o[x.type]=x.value});
 return o;
}
function idBaru(){
 const d=waktuWIB();
 const rand=Math.floor(Math.random()*900)+100;
 return `GBT-${d.year}${d.month}${d.day}-${d.hour}${d.minute}${d.second}-${rand}`;
}
function nowText(){
 const d=waktuWIB();
 const m=['Jan','Feb','Mar','Apr','Mei','Jun','Jul','Agu','Sep','Okt','Nov','Des'];
 return `${d.day} ${m[Number(d.month)-1]} ${d.year}, ${d.hour}:${d.minute}:${d.second} WIB`;
}
function refreshFormClock(){
 const el=$('fWaktu');
 if(!el)return;
 // Waktu pengamatan ditetapkan saat form mulai digunakan, bukan berubah setelah data diisi.
 if(!el.value)el.value=nowText();
}
function esc(v){return String(v??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m]))}
function slug(v){return String(v||'').toLowerCase()}
function showToast(msg){const t=$('toast');t.textContent=msg;t.style.display='block';clearTimeout(window.__toast);window.__toast=setTimeout(()=>t.style.display='none',3200)}
function getData(){
 try{
   const raw=localStorage.getItem(KEY);
   if(raw)return JSON.parse(raw);
 }catch(e){console.error(e)}
 return [];
}
function setData(data){localStorage.setItem(KEY,JSON.stringify(data))}
function calcStatus(mat,asap,api){
 mat=parseFloat(mat);
 if(api==='ada')return 'DARURAT';
 if(asap==='ada'||(!isNaN(mat)&&mat<=-60))return 'WASPADA';
 if(!isNaN(mat)&&mat<=-40)return 'WASPADA';
 return 'AMAN';
}
function statusBadge(s){return `<span class="badge ${slug(s)}">${esc(s)}</span>`}
function filteredData(){
 let d=getData();
 const st=$('dashStart')?.value||'',en=$('dashEnd')?.value||'',k=$('dashKec')?.value||'';
 if(st||en||k)d=d.filter(r=>{
   const date=(r.waktu||'').split(',')[0];
   const parts=date.split(' '); let iso='';
   if(parts.length===3){const mm={'Jan':'01','Feb':'02','Mar':'03','Apr':'04','Mei':'05','Jun':'06','Jul':'07','Agu':'08','Sep':'09','Okt':'10','Nov':'11','Des':'12'};iso=`${parts[2]}-${mm[parts[1]]}-${parts[0].padStart(2,'0')}`}
   return (!st||iso>=st)&&(!en||iso<=en)&&(!k||r.kecamatan===k);
 });
 return d;
}
function populateKec(){
 const kec=[...new Set(getData().map(x=>x.kecamatan).filter(Boolean))];
 ['dashKec'].forEach(id=>{
   const s=$(id);if(!s)return;
   const old=s.value;s.innerHTML='<option value="">Semua</option>'+kec.map(k=>`<option>${esc(k)}</option>`).join('');s.value=old;
 });
}
function avg(d,key){
 const a=d.map(x=>parseFloat(x[key])).filter(Number.isFinite);
 return a.length?(a.reduce((p,c)=>p+c,0)/a.length):null;
}
function renderDashboard(){
 populateKec();
 const d=filteredData();
 const counts={AMAN:d.filter(x=>x.status==='AMAN').length,WASPADA:d.filter(x=>x.status==='WASPADA').length,DARURAT:d.filter(x=>x.status==='DARURAT').length};
 $('kpiTotal').textContent=d.length;
 $('kpiAman').textContent=counts.AMAN;$('kpiWaspada').textContent=counts.WASPADA;$('kpiDarurat').textContent=counts.DARURAT;
 const total=Math.max(1,d.length);
 $('amanPct').textContent=(counts.AMAN/total*100).toFixed(1)+'% dari total';
 $('waspadaPct').textContent=(counts.WASPADA/total*100).toFixed(1)+'% dari total';
 $('daruratPct').textContent=(counts.DARURAT/total*100).toFixed(1)+'% dari total';
 $('sumAman').textContent=counts.AMAN+' lokasi'; $('sumWaspada').textContent=counts.WASPADA+' lokasi'; $('sumDarurat').textContent=counts.DARURAT+' lokasi';
 $('summaryStatus').textContent=counts.DARURAT>0?'DARURAT':counts.WASPADA>0?'WASPADA':'AMAN';
 const m=avg(d,'tinggi_muka_air_gambut'),t=avg(d,'suhu');
 $('kpiMat').textContent=m===null?'—':m.toFixed(1)+' cm';$('kpiTemp').textContent=t===null?'—':t.toFixed(1)+'°';
 const now=new Date(); $('lastUpdate').textContent=now.toLocaleString('id-ID',{dateStyle:'medium',timeStyle:'short'});
 $('dashDate').textContent=now.toLocaleDateString('id-ID',{weekday:'long',day:'2-digit',month:'short',year:'numeric'});
 $('dashClock').textContent=now.toLocaleTimeString('id-ID',{hour:'2-digit',minute:'2-digit'})+' WIB';
 renderTMATChart(d,'tmatChart');renderStatusBars(counts);renderLatest(d);
 renderDashboardMap(d);
}
function svgLineChart(data){
 if(!data.length)return '<div class="empty">Belum ada data untuk grafik.</div>';
 const w=760,h=280,pad={l:45,r:20,t:18,b:38};
 const vals=data.map(x=>parseFloat(x.tinggi_muka_air_gambut)).filter(Number.isFinite);
 const min=Math.min(-75,Math.min(...vals)-5),max=Math.max(-25,Math.max(...vals)+5);
 const x=i=>pad.l+(i/(Math.max(1,data.length-1)))*(w-pad.l-pad.r);
 const y=v=>pad.t+((max-v)/(max-min))*(h-pad.t-pad.b);
 const points=data.map((r,i)=>`${x(i).toFixed(1)},${y(parseFloat(r.tinggi_muka_air_gambut)).toFixed(1)}`).join(' ');
 const yTicks=[-20,-40,-60,-80].filter(v=>v>=min&&v<=max);
 let grid=yTicks.map(v=>`<line x1="${pad.l}" x2="${w-pad.r}" y1="${y(v)}" y2="${y(v)}" stroke="#e7eee9"/><text x="${pad.l-7}" y="${y(v)+4}" text-anchor="end" font-size="10" fill="#738077">${v}</text>`).join('');
 let labels=data.map((r,i)=>i%Math.ceil(data.length/7)===0?`<text x="${x(i)}" y="${h-12}" text-anchor="middle" font-size="9" fill="#738077">${esc((r.waktu||'').split(',')[0]||'')}</text>`:'').join('');
 const circles=data.map((r,i)=>`<circle cx="${x(i)}" cy="${y(parseFloat(r.tinggi_muka_air_gambut))}" r="4" fill="#23834b"><title>${esc(r.waktu)} — ${r.tinggi_muka_air_gambut} cm</title></circle>`).join('');
 return `<svg viewBox="0 0 ${w} ${h}" role="img" aria-label="Grafik TMAT">${grid}
 <line x1="${pad.l}" x2="${w-pad.r}" y1="${y(-40)}" y2="${y(-40)}" stroke="#c98900" stroke-dasharray="5 5"/>
 <line x1="${pad.l}" x2="${w-pad.r}" y1="${y(-60)}" y2="${y(-60)}" stroke="#b52b2b" stroke-dasharray="5 5"/>
 <polyline points="${points}" fill="none" stroke="#23834b" stroke-width="4" stroke-linejoin="round" stroke-linecap="round"/>
 ${circles}${labels}
 <line x1="${pad.l}" x2="${pad.l}" y1="${pad.t}" y2="${h-pad.b}" stroke="#cfd9d2"/>
 <line x1="${pad.l}" x2="${w-pad.r}" y1="${h-pad.b}" y2="${h-pad.b}" stroke="#cfd9d2"/>
 </svg>`;
}
function renderTMATChart(data,id){$(id).innerHTML=svgLineChart(data)}
function renderStatusBars(c){
 const max=Math.max(1,c.AMAN,c.WASPADA,c.DARURAT);
 const rows=[['AMAN',c.AMAN,'#23834b'],['WASPADA',c.WASPADA,'#c98900'],['DARURAT',c.DARURAT,'#e33b3b']];
 $('statusBars').innerHTML=rows.map(r=>`<div class="status-col"><div class="num">${r[1]}</div><div class="barv" style="height:${Math.max(12,(r[1]/max)*115)}px;background:${r[2]}"></div><div class="lab">${r[0]}</div></div>`).join('');
}
function renderLatest(d){
 $('latestTable').innerHTML=d.slice().reverse().slice(0,7).map(r=>`<tr><td><b>${esc(r.id_laporan)}</b></td><td>${esc(r.kecamatan)}</td><td>${esc(r.waktu)}</td><td>${esc(r.tinggi_muka_air_gambut)} cm</td><td>${esc(r.suhu)} °C</td><td>${esc(r.vegetasi||'-')}</td><td>${esc(r.ada_asap)}</td><td>${esc(r.ada_api)}</td><td>${statusBadge(r.status)}</td></tr>`).join('')||'<tr><td colspan="9" class="empty">Belum ada laporan.</td></tr>';
}
function initMap(target,center,zoom){
 if(!window.L)return null;
 const map=L.map(target).setView(center,zoom);
 const tiles=L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}',{maxZoom:19,attribution:'&copy; Esri, HERE, Garmin, USGS, EPA, NPS'});
 tiles.on('tileerror',()=>showToast('Tile peta belum dapat dimuat. Periksa koneksi internet.'));
 tiles.addTo(map);
 return map;
}
function colorFor(s){return s==='DARURAT'?'#b52b2b':s==='WASPADA'?'#c98900':'#23834b'}
function markerIcon(status){
 const c=colorFor(status);
 return L.divIcon({className:'custom-marker',html:`<div style="width:18px;height:18px;border-radius:50%;background:${c};border:3px solid white;box-shadow:0 2px 8px rgba(0,0,0,.35)"></div>`,iconSize:[18,18],iconAnchor:[9,9]});
}
function renderMarkers(map,layer,data,statusFilter){
 if(layer)layer.clearLayers(); else layer=L.layerGroup().addTo(map);
 const subset=data.filter(r=>{
   if(statusFilter&&r.status!==statusFilter)return false;
   const p=(r.gps||'').split(',').map(Number);
   return p.length===2&&Number.isFinite(p[0])&&Number.isFinite(p[1]);
 });
 subset.forEach(r=>{
   const p=r.gps.split(',').map(Number);
   L.marker(p,{icon:markerIcon(r.status)}).bindPopup(`<b>${esc(r.id_laporan)}</b><br>${esc(r.kecamatan)}<br>TMAT: ${esc(r.tinggi_muka_air_gambut)} cm<br>Suhu: ${esc(r.suhu)} °C<br>Status: <b>${esc(r.status)}</b>`).addTo(layer);
 });
 return layer;
}
function renderDashboardMap(data){
 if(!dashMap){
   dashMap=initMap('dashMap',TELUK,11);
   if(!dashMap)return;
   dashLayer=L.layerGroup().addTo(dashMap);
 }
 dashLayer=renderMarkers(dashMap,dashLayer,data,'');
 setTimeout(()=>dashMap.invalidateSize(),100);
}
function initMainMap(){
 if(mainMap||!window.L)return;
 mainMap=initMap('mainMap',TELUK,11);
 if(!mainMap)return;
 mainLayer=L.layerGroup().addTo(mainMap);
 renderMapMarkers();
}
function renderMapMarkers(){
 if(!mainMap)return;
 const d=filteredData();
 mainLayer=renderMarkers(mainMap,mainLayer,d,$('mapStatus').value);
 $('mapCount').textContent=d.length+' titik';
 const counts={AMAN:d.filter(x=>x.status==='AMAN').length,WASPADA:d.filter(x=>x.status==='WASPADA').length,DARURAT:d.filter(x=>x.status==='DARURAT').length};
 $('mapSummary').innerHTML=`<div class="metric-list">${Object.entries(counts).map(([k,v])=>`<div class="metric"><span>${statusBadge(k)}</span><b>${v} titik</b></div>`).join('')}</div>`;
 setTimeout(()=>mainMap.invalidateSize(),100);
}
function centerTelukPakedai(){if(mainMap){mainMap.setView(TELUK,12);showToast('Peta difokuskan ke Teluk Pakedai.')}} 
function renderMonitoring(){
 const q=($('tableSearch').value||'').toLowerCase(),st=$('tableStatus').value;
 let d=getData().filter(r=>!st||r.status===st);
 if(q)d=d.filter(r=>JSON.stringify(r).toLowerCase().includes(q));
 d=d.slice().reverse();
 $('monitorTable').innerHTML=d.map(r=>`<tr>
 <td><b>${esc(r.id_laporan)}</b></td><td>${esc(r.waktu)}</td><td>${esc(r.kecamatan)}</td><td>${esc(r.nama_petugas||'-')}</td><td>${esc(r.gps)}</td>
 <td>${esc(r.tinggi_muka_air_gambut)} cm</td><td>${esc(r.suhu)} °C</td><td>${esc(r.vegetasi||'-')}</td><td>${esc(r.ada_asap)}</td><td>${esc(r.ada_api)}</td><td>${statusBadge(r.status)}</td>
 <td><button class="btn btn-light" onclick="viewReport('${esc(r.id_laporan)}')">Detail</button></td></tr>`).join('')||'<tr><td colspan="12" class="empty">Data tidak ditemukan.</td></tr>';
}
async function renderDocs(){
 const q=($('docSearch').value||'').toLowerCase(),type=$('docType').value;
 const docs=[];
 getData().slice().reverse().forEach(r=>{
   if(r.foto_mat)docs.push({type:'TMAT',title:'Foto Rambu Ukur TMAT',key:r.foto_mat,row:r});
   if(r.foto_vegetasi)docs.push({type:'Vegetasi',title:'Foto Vegetasi & Ekosistem',key:r.foto_vegetasi,row:r});
   if(r.foto_asap)docs.push({type:'Asap',title:'Foto Asap',key:r.foto_asap,row:r});
   if(r.video_situasi)docs.push({type:'Video',title:'Video Situasi Lapangan',key:r.video_situasi,row:r});
 });
 const out=docs.filter(d=>(!type||d.type===type)&&(!q||(`${d.title} ${d.key} ${d.row.id_laporan} ${d.row.kecamatan}`).toLowerCase().includes(q)));
 if(!out.length){$('docGrid').innerHTML='<div class="card empty" style="grid-column:1/-1">Belum ada dokumentasi foto/video yang terekam.</div>';return}
 const cards=await Promise.all(out.map(async d=>{const m=await getMedia(d.key);const media=m?.blob?URL.createObjectURL(m.blob):'';const gps=m?.meta?.gps;return `<div class="doc-card"><div class="doc-media">${media?(d.type==='Video'?`<video src="${media}" controls></video>`:`<img src="${media}" alt="${esc(d.title)}">`):(d.type==='Video'?'🎥':'📷')}</div><div class="doc-body"><div class="doc-title">${esc(d.title)}</div><div class="doc-meta">${m?'✓ Foto asli tersimpan':'Media belum tersedia'}<br>${esc(d.row.id_laporan)} • ${esc(d.row.waktu)}<br>${gps?`GPS ${gps.lat.toFixed(6)}, ${gps.lon.toFixed(6)}<br>`:''}${statusBadge(d.row.status)}</div></div></div>`}));
 $('docGrid').innerHTML=cards.join('');
}
function renderReports(){
 try{
  let d=filteredData();
  if(!d.length) d=getData();
  const m=avg(d,'tinggi_muka_air_gambut'),t=avg(d,'suhu');
  const fire=d.filter(x=>String(x.ada_api||'').toLowerCase()==='ada').length;
  const smoke=d.filter(x=>String(x.ada_asap||'').toLowerCase()==='ada').length;
  const counts={AMAN:d.filter(x=>String(x.status||'').toUpperCase()==='AMAN').length,WASPADA:d.filter(x=>String(x.status||'').toUpperCase()==='WASPADA').length,DARURAT:d.filter(x=>String(x.status||'').toUpperCase()==='DARURAT').length};
  const mats=d.map(x=>parseFloat(x.tinggi_muka_air_gambut)).filter(Number.isFinite);
  const temps=d.map(x=>parseFloat(x.suhu)).filter(Number.isFinite);
  $('reportMetrics').innerHTML=[['Total laporan',d.length],['AMAN',counts.AMAN],['WASPADA',counts.WASPADA],['DARURAT',counts.DARURAT],['Laporan dengan api',fire],['Laporan dengan asap',smoke]].map(x=>`<div class="metric"><span>${x[0]}</span><b>${x[1]}</b></div>`).join('');
  $('envMetrics').innerHTML=[['Rata-rata TMAT',m===null?'—':m.toFixed(1)+' cm'],['Rata-rata suhu',t===null?'—':t.toFixed(1)+' °C'],['TMAT terendah',mats.length?Math.min(...mats).toFixed(1)+' cm':'—'],['Suhu tertinggi',temps.length?Math.max(...temps).toFixed(1)+' °C':'—']].map(x=>`<div class="metric"><span>${x[0]}</span><b>${x[1]}</b></div>`).join('');
  $('reportChart').innerHTML=svgLineChart(d);
  $('reportStatusChart').innerHTML=svgStatusChart(counts);
  $('reportTempChart').innerHTML=svgTempChart(d);
 }catch(e){
  console.error('renderReports',e);
  ['reportMetrics','envMetrics','reportChart','reportStatusChart','reportTempChart'].forEach(id=>{if($(id))$(id).innerHTML='<div class="report-chart-empty">Data laporan belum dapat ditampilkan.</div>'});
 }
}
function renderAll(){renderDashboard();renderMonitoring();renderDocs();renderReports();if(mainMap)renderMapMarkers()}
function navigate(page){
 document.querySelectorAll('.page').forEach(x=>x.classList.remove('active'));
 const p=$('page-'+page);if(p)p.classList.add('active');
 document.querySelectorAll('.nav button').forEach(b=>b.classList.toggle('active',b.dataset.page===page));
 $('topTitle').textContent=pageTitles[page]||'GambutWatch';
 if(page==='map'){setTimeout(()=>{initMainMap();renderMapMarkers()},120)}
 if(page==='dashboard'){setTimeout(()=>{if(dashMap)dashMap.invalidateSize()},100)}
 if(page==='input'){prepareForm()}
 $('sidebar').classList.remove('open');window.scrollTo({top:0,behavior:'smooth'});
}
function prepareForm(){
 if(!$('fId').value)$('fId').value=idBaru();
 if(!$('fWaktu').value)$('fWaktu').value=nowText();
 ['TMAT','Vegetasi','Asap'].forEach(refreshPhotoUI);
}
function previewFile(inputId,previewId){
 const f=$(inputId).files[0];if(!f)return;
 const el=$(previewId);el.src=URL.createObjectURL(f);el.style.display='block';
}
function calcFormStatus(){
 const s=calcStatus($('fMat').value,$('fAsap').value,$('fApi').value);
 const el=$('formStatus');el.textContent=s;el.className='status-preview '+slug(s);
}
function ambilGPS(){
 if(!navigator.geolocation){showToast('Browser tidak mendukung GPS.');return}
 $('fGps').value='Mengambil GPS...';
 navigator.geolocation.getCurrentPosition(p=>{
   $('fGps').value=`${p.coords.latitude.toFixed(6)}, ${p.coords.longitude.toFixed(6)}`;
   showToast('GPS berhasil diambil.');
 },()=>{$('fGps').value='';showToast('GPS gagal. Aktifkan izin lokasi browser.')},{enableHighAccuracy:true,timeout:15000});
}
async function saveReport(){
 if(!$('fId').value)$('fId').value=idBaru();
 if(!$('fWaktu').value)$('fWaktu').value=nowText();
 const required=[['fKec','Kecamatan'],['fGps','GPS'],['fMat','TMAT'],['fSuhu','Suhu'],['fApi','Api'],['fAsap','Asap']];
 for(const [id,label] of required){
   const el=$(id);const empty=el.type==='file'?!el.files.length:!el.value;
   if(empty){showToast('Lengkapi data wajib: '+label);el.focus();return}
 }
 if(!pendingMedia.TMAT?.blob){showToast('Foto Rambu Ukur TMAT wajib diambil.');return}
 if(!pendingMedia.Vegetasi?.blob){showToast('Foto Vegetasi & Ekosistem wajib diambil.');return}
 const r={
  id_laporan:$('fId').value||idBaru(),nama_lokasi:$('fKab').value,kecamatan:$('fKec').value,nama_petugas:$('fPetugas').value,
  gps:$('fGps').value,waktu:$('fWaktu').value,tinggi_muka_air_gambut:$('fMat').value,suhu:$('fSuhu').value,
  vegetasi:$('fVegetasi').value,ada_api:$('fApi').value,ada_asap:$('fAsap').value,
  foto_mat:pendingMedia.TMAT?.key||'',foto_vegetasi:pendingMedia.Vegetasi?.key||'',foto_asap:pendingMedia.Asap?.key||'',
  video_situasi:$('fVideo').files[0]?.name||'',status:calcStatus($('fMat').value,$('fAsap').value,$('fApi').value),created_at:new Date().toISOString()
 };
 const data=getData();data.push(r);setData(data);
 if($('fVideo').files[0]){try{await saveMedia(r.id_laporan+'_Video',$('fVideo').files[0],{type:'Video',reportId:r.id_laporan,time:new Date().toISOString(),gps:r.gps})}catch(e){console.warn(e)}}
 let sent=false;
 try{
   const scriptOn=$('scriptToggle')?.classList.contains('on');
   if(scriptOn){
    await fetch(WEB_APP_URL,{method:'POST',mode:'no-cors',headers:{'Content-Type':'text/plain;charset=utf-8'},body:JSON.stringify(r)});
    sent=true;
   }
 }catch(e){console.warn(e)}
 showToast(sent?'Laporan tersimpan dan dikirim ke endpoint.':'Laporan tersimpan di perangkat.');
 resetForm();renderAll();navigate('monitoring');
}
function resetForm(){
 pendingMedia={};
 ['TMAT','Vegetasi','Asap'].forEach(refreshPhotoUI);
 ['fPetugas','fGps','fMat','fSuhu','fVegetasi'].forEach(id=>$(id).value='');
 ['fApi','fAsap'].forEach(id=>$(id).value='');
 ['fVideo'].forEach(id=>$(id).value='');
 ['pFotoMat','pFotoVeg','pFotoAsap','pVideo'].forEach(id=>{$(id).style.display='none';if($(id).tagName==='IMG')$(id).src='';else $(id).removeAttribute('src')});
 ['photoMetaTMAT','photoMetaVegetasi'].forEach(id=>$(id).textContent='Belum ada foto. Ambil foto langsung dari kamera.');$('photoMetaAsap').textContent='Opsional — ambil foto jika terdapat asap.';$('fId').value=idBaru();$('fWaktu').value=nowText();$('formStatus').textContent='Lengkapi TMAT dan indikator asap/api';$('formStatus').className='status-preview';
}
function viewReport(id){
 const r=getData().find(x=>x.id_laporan===id);if(!r)return;
 alert(`DETAIL LAPORAN\\n\\nID: ${r.id_laporan}\\nWaktu: ${r.waktu}\\nKecamatan: ${r.kecamatan}\\nPetugas: ${r.nama_petugas||'-'}\\nGPS: ${r.gps}\\nTMAT: ${r.tinggi_muka_air_gambut} cm\\nSuhu: ${r.suhu} °C\\nAsap: ${r.ada_asap}\\nApi: ${r.ada_api}\\nStatus: ${r.status}\\n\\nVegetasi: ${r.vegetasi||'-'}`);
}
function normalizedExportRows(){
 const d=getData();
 return d.map((r,i)=>({
  No:i+1, 'ID Laporan':r.id_laporan||'', 'Kabupaten':r.nama_lokasi||'Kabupaten Kubu Raya', 'Kecamatan':r.kecamatan||'', 'Nama Petugas':r.nama_petugas||'',
  GPS:r.gps||'', Waktu:r.waktu||'', 'TMAT (cm)':r.tinggi_muka_air_gambut??'', 'Suhu (°C)':r.suhu??'', Vegetasi:r.vegetasi||'', Asap:r.ada_asap||'', Api:r.ada_api||'',
  'Foto Rambu TMAT':r.foto_mat||'', 'Foto Vegetasi':r.foto_vegetasi||'', 'Foto Asap':r.foto_asap||'', 'Video Situasi':r.video_situasi||'', Status:r.status||'', 'Waktu Simpan':r.created_at||''
 }));
}
function exportCSV(){
 const rows=normalizedExportRows(); if(!rows.length){showToast('Belum ada data monitoring tersimpan.');return}
 const cols=Object.keys(rows[0]);
 const csv='\uFEFF'+[cols,...rows.map(r=>cols.map(c=>`"${String(r[c]??'').replace(/"/g,'""')}"`))].map(a=>a.join(';')).join('\r\n');
 const blob=new Blob([csv],{type:'text/csv;charset=utf-8;'});const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download='gambutwatch_data_monitoring.csv';document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),500);showToast(`${rows.length} laporan berhasil diekspor ke CSV.`);
}
function exportExcel(){
 const rows=normalizedExportRows(); if(!rows.length){showToast('Belum ada data monitoring tersimpan.');return}
 const cols=Object.keys(rows[0]);
 const escX=v=>String(v??'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
 const head=cols.map(c=>`<th>${escX(c)}</th>`).join('');
 const body=rows.map(r=>`<tr>${cols.map(c=>`<td>${escX(r[c])}</td>`).join('')}</tr>`).join('');
 const html=`<html><head><meta charset="UTF-8"><style>body{font-family:Calibri,Arial}table{border-collapse:collapse}th,td{border:1px solid #aebfb4;padding:6px 8px;white-space:nowrap}th{background:#dcefe3;font-weight:700}</style></head><body><table><thead><tr>${head}</tr></thead><tbody>${body}</tbody></table></body></html>`;
 const blob=new Blob([html],{type:'application/vnd.ms-excel;charset=utf-8'});const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download='gambutwatch_data_monitoring.xls';document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),500);showToast(`${rows.length} laporan berhasil diekspor ke Excel.`);
}
async function resetAllLocalData(){
  if(!confirm('Reset semua data lokal GambutWatch? Laporan dan dokumentasi foto/video di perangkat ini akan dihapus. Data pada server tidak terhapus.')) return;
  const keys=['gambutwatch_data','gambutwatch_monitoring','gambutwatch_modern_v1','gambutwatch_data_monitoring',KEY];
  keys.forEach(k=>localStorage.removeItem(k));
  try{await new Promise((resolve)=>{const req=indexedDB.deleteDatabase(MEDIA_DB);req.onsuccess=req.onerror=req.onblocked=()=>resolve();});}catch(e){}
  pendingMedia={};
  renderAll();
  resetForm();
  showToast('Semua data lokal dan dokumentasi berhasil direset.');
}
function deleteAll(){resetAllLocalData();}
