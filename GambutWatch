function printReport(){
 document.querySelectorAll('.page').forEach(x=>x.classList.remove('print-page'));
 $('page-reports').classList.add('print-page');window.print();setTimeout(()=>{$('page-reports').classList.remove('print-page');},500);
}

document.querySelectorAll('.nav button').forEach(btn=>btn.addEventListener('click',()=>navigate(btn.dataset.page)));
$('mobileMenu').addEventListener('click',()=>$('sidebar').classList.toggle('open'));
['fMat','fSuhu','fApi','fAsap'].forEach(id=>$(id).addEventListener('input',calcFormStatus));
$('fVideo').addEventListener('change',()=>{const f=$('fVideo').files[0];if(!f)return;$('pVideo').src=URL.createObjectURL(f);$('pVideo').style.display='block'});
$('dashStart').addEventListener('change',renderDashboard);$('dashEnd').addEventListener('change',renderDashboard);$('dashKec').addEventListener('change',renderDashboard);

function migrateLegacyData(){
 const keys=['gambutwatch_data','gambutwatch_monitoring','gambutwatch_modern_v1','gambutwatch_data_monitoring'];
 let current=getData();
 if(current.length)return;
 for(const k of keys){try{const raw=localStorage.getItem(k);if(!raw)continue;const parsed=JSON.parse(raw);if(Array.isArray(parsed)&&parsed.length){setData(parsed);return;}}catch(e){}}
}
migrateLegacyData();
prepareForm();
// Pastikan ID dan tanggal selalu terisi setelah halaman selesai dimuat.
window.addEventListener('load',prepareForm);
renderAll();
</script>

