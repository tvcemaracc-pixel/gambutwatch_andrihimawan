.btn{border:0;border-radius:10px;padding:10px 14px;font-weight:800;font-size:12px}
.btn-primary{background:var(--green-800);color:#fff}
.btn-secondary{background:#eef4ef;color:var(--green-900)}
.btn-danger{background:var(--red-bg);color:var(--red)}
